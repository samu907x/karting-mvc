@model List<Piloto>
@{
    ViewData["Title"] = "Posiciones";
    string categoriaActiva = ViewBag.Categoria as string ?? "Todas";
    var categorias = new[] { "Todas", "Infantil", "Juvenil", "Pro / Libre" };
}

<section class="py-5">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
            <h1 class="titulo-seccion mb-0">Tabla de posiciones</h1>
            <div class="d-flex gap-2">
                <a asp-action="Create" class="btn btn-danger">Inscribir piloto</a>
                <a asp-action="Resultado" class="btn btn-dark">Registrar resultado</a>
            </div>
        </div>

        <!-- Filtro por categoría: cada botón es un enlace GET con ?categoria=... -->
        <div class="btn-group flex-wrap mb-3" role="group" aria-label="Filtrar por categoría">
            @foreach (var c in categorias)
            {
                <a asp-action="Index" asp-route-categoria="@c"
                   class="btn btn-outline-dark @(c == categoriaActiva ? "active" : "")">@c</a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle tabla-posiciones">
                <caption>Clasificación general del campeonato</caption>
                <thead>
                    <tr>
                        <th scope="col">Pos.</th>
                        <th scope="col">Piloto</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Motor</th>
                        <th scope="col" class="text-end">Puntos</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var p = Model[i];
                        <tr class="@(i == 0 ? "fila-lider" : "")">
                            <td class="posicion">@(i + 1)°</td>
                            <td>@p.Nombre</td>
                            <td><span class="badge text-bg-secondary">@p.Categoria</span></td>
                            <td>@p.Motor</td>
                            <td class="text-end puntos">@p.Puntos</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-dark">Ver</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Quitar a este piloto del campeonato?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Quitar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4"><strong>Pilotos mostrados</strong></td>
                        <td colspan="2" class="text-end"><strong>@Model.Count</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (Model.Count == 0)
        {
            <p class="alert alert-warning">No hay pilotos en esta categoría todavía.</p>
        }
    </div>
</section>
