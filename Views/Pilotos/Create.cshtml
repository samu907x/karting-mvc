@model Piloto
@{
    ViewData["Title"] = "Inscripción";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="card">
                    <div class="card-body p-4">
                        <h1 class="h3 mb-3">Inscribe a un piloto</h1>

                        <!-- Formulario: al enviarlo se ejecuta la acción POST Create del controlador -->
                        <form asp-action="Create" method="post">
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label asp-for="Nombre" class="form-label">Nombre completo</label>
                                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Samuel Ramírez" />
                                    <span asp-validation-for="Nombre" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label asp-for="Correo" class="form-label">Correo</label>
                                    <input asp-for="Correo" class="form-control" placeholder="correo@@ejemplo.com" />
                                    <span asp-validation-for="Correo" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label asp-for="Edad" class="form-label">Edad</label>
                                    <input asp-for="Edad" type="number" class="form-control" placeholder="7 a 60" />
                                    <span asp-validation-for="Edad" class="text-danger"></span>
                                </div>
                                <div class="col-12 col-md-8">
                                    <span class="form-label d-block">Tipo de motor</span>
                                    <div class="form-check form-check-inline mt-1">
                                        <input asp-for="Motor" type="radio" value="2 Tiempos" id="motor2t" class="form-check-input" />
                                        <label for="motor2t" class="form-check-label">2 Tiempos</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input asp-for="Motor" type="radio" value="4 Tiempos" id="motor4t" class="form-check-input" />
                                        <label for="motor4t" class="form-check-label">4 Tiempos</label>
                                    </div>
                                    <div><span asp-validation-for="Motor" class="text-danger"></span></div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input asp-for="AceptaReglamento" class="form-check-input" />
                                        <label asp-for="AceptaReglamento" class="form-check-label">
                                            Acepto el reglamento y las políticas de seguridad de las pistas
                                        </label>
                                    </div>
                                    <span asp-validation-for="AceptaReglamento" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <p class="small text-secondary">La categoría se asigna automáticamente según la edad.</p>
                                    <button type="submit" class="btn btn-danger">Enviar inscripción</button>
                                    <a asp-action="Index" class="btn btn-outline-dark">Cancelar</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
